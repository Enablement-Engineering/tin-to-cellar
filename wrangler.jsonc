{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tin-to-cellar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "CATALOG_CONTRIBUTIONS",
        "class_name": "CatalogContributions"
      }
    ]
  },
  "migrations": [
    {
      "tag": "proof-budget-v1",
      "new_sqlite_classes": [
        "ProofBudget"
      ]
    },
    {
      "tag": "catalog-contributions-v1",
      "new_sqlite_classes": [
        "CatalogContributions"
      ]
    },
    {
      "tag": "proof-budget-retired-v1",
      "deleted_classes": [
        "ProofBudget"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "CONTRIBUTION_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "tintocellar.com",
      "custom_domain": true
    },
    {
      "pattern": "www.tintocellar.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": false
  }
}
