{
  "name": "tin-to-cellar",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run cellarpack:validators && npm run feedback:validators && npm run protocol:release && npm run prepare:ocr && vite",
    "build": "npm run cellarpack:validators && npm run feedback:validators && npm run protocol:release && npm run prepare:ocr && tsc -b && vite build",
    "app-release:prepare": "node scripts/app-release.mjs prepare",
    "app-release:retain": "node scripts/app-release.mjs retain",
    "test:recovery": "playwright test --config playwright.recovery.config.ts",
    "test:usage-resilience": "playwright test --config playwright.usage-resilience.config.ts",
    "test:theme": "playwright test --config playwright.theme.config.ts",
    "test:mobile": "npm run build && playwright test --config playwright.mobile.config.ts",
    "cellarpack:validators": "node scripts/cellarpack-validators.mjs",
    "feedback:validators": "node scripts/feedback-validators.mjs",
    "protocol:release": "node scripts/protocol-release.mjs",
    "protocol:history": "node scripts/diagnostics/protocol-history.mjs",
    "lint": "oxlint",
    "test": "npm run cellarpack:validators && npm run feedback:validators && npm run protocol:release && vitest run",
    "test:watch": "npm run cellarpack:validators && npm run feedback:validators && npm run protocol:release && vitest",
    "diagnostics:fetch": "node --env-file-if-exists=.env.diagnostics scripts/diagnostics/review.mjs fetch",
    "diagnostics:budget": "node --env-file-if-exists=.env.diagnostics scripts/diagnostics/budget.mjs",
    "diagnostics:smoke": "npm run cellarpack:validators && npm run feedback:validators && node scripts/diagnostics/budget-smoke.mjs",
    "diagnostics:demo": "node scripts/diagnostics/demo.mjs",
    "diagnostics:analyze": "node scripts/diagnostics/review.mjs analyze",
    "diagnostics:complete": "node scripts/diagnostics/review.mjs complete",
    "diagnostics:backfill": "node scripts/diagnostics/backfill.mjs",
    "diagnostics:migrate:local": "wrangler d1 migrations apply DIAGNOSTICS --local",
    "diagnostics:migrate:remote": "wrangler d1 migrations apply DIAGNOSTICS --remote",
    "preview": "wrangler dev --local",
    "preview:frontend": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "preview:cloudflare": "npm run dev",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "test:a11y": "playwright test",
    "gallery:dev": "npm run dev --",
    "gallery:test:server": "node scripts/gallery/start-local.mjs --test",
    "test:gallery": "npm run build && playwright test --config playwright.gallery.config.ts",
    "gallery:seed": "node scripts/gallery/seed-catalog.mjs",
    "gallery:seed:public-local": "node scripts/gallery/seed-public-local.mjs",
    "gallery:prepare-release": "node scripts/gallery/prepare-release.mjs",
    "gallery:agent": "node scripts/gallery/agent-client.mjs",
    "gallery:migrate-labels": "node scripts/gallery/migrate-label-metadata.mjs",
    "gallery:prepare-previews": "node scripts/gallery/prepare-image-previews.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "ajv": "8.20.0",
    "fast-png": "8.0.0",
    "jose": "6.2.12",
    "jszip": "3.10.2",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "oxlint": "^1.83.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.2"
  }
}
